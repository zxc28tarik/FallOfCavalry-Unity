    <ProjectReference Include="FOC.Domain.csproj" />
    <ProjectReference Include="FOC.Application.csproj" />
    <ProjectReference Include="FOC.Infrastructure.csproj" />
    <Compile Include="..\UnityProject\Assets\FOC\Tests\EditMode\**\*.cs" />
  </ItemGroup>
</Project>

