.foc-layout--compact .foc-context-panel { display: none; }
.foc-layout--compact .foc-navigation { width: 164px; }
.foc-layout--compact .foc-card, .foc-layout--compact .foc-card--primary { width: 47%; min-width: 220px; }
.foc-layout--wide .foc-context-panel { width: 340px; }
.foc-layout--wide .foc-navigation { width: 216px; }
.foc-layout--wide .foc-card { width: 31%; }
.foc-layout--wide .foc-card--primary { width: 64%; }
.foc-virtual-list { flex-shrink: 0; border-width: 0; background-color: rgba(0,0,0,0); }
.foc-details { margin-top: 8px; }
.foc-world-map {
    height: 380px;
    margin-bottom: 14px;
    border-width: 1px;
    border-color: rgba(176, 151, 101, 0.8);
    background-color: rgb(31, 45, 48);
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
}

.foc-travel-toolbar { padding: 12px; margin-bottom: 8px; background-color: rgb(30,34,34); border-color: rgb(83,84,75); border-width: 1px; }
.foc-travel-top { flex-direction: row; align-items: center; flex-wrap: wrap; }
#travel-destination { width: 240px; margin-right: 12px; }
#travel-destination > .unity-base-field__label { min-width: 80px; width: 80px; max-width: 80px; }
.foc-travel-summary { flex-grow: 1; min-width: 270px; padding: 4px; }
.foc-travel-route { font-size: 16px; -unity-font-style: bold; color: rgb(239,201,130); }
.foc-travel-buttons { flex-direction: row; flex-wrap: wrap; }
.foc-travel-buttons > Button { height: 32px; padding-left: 12px; padding-right: 12px; color: rgb(240,226,195); background-color: rgb(58,63,51); }
#travel-start { background-color: rgb(103,78,40); }
#travel-summary, #travel-stops, #travel-help { white-space: normal; font-size: 11px; }
#travel-stops { color: rgb(181,181,153); margin-top: 5px; }
.foc-travel-status { white-space: normal; margin-top: 5px; margin-bottom: 3px; }
.foc-map-marker--selected { border-color: rgb(255,224,137); border-width: 2px; background-color: rgb(110,79,32); }
#travel-progress { height: 18px; margin-top: 4px; }

.foc-map-marker {
    width: 110px;
    max-width: 110px;
    height: 28px;
    margin-left: -55px;
    margin-top: -14px;
    color: rgb(245, 227, 184);
    background-color: rgba(45, 33, 22, 0.88);
    border-color: rgb(190, 151, 79);
    border-width: 1px;
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.foc-map-progress {
    position: absolute;
    left: 16px;
    bottom: 14px;
    padding: 7px 12px;
    color: rgb(248, 231, 193);
    background-color: rgba(29, 24, 19, 0.92);
}

.foc-trade-panel {
    display: none;
    background-color: rgb(31, 37, 35);
    border-color: rgb(153, 127, 78);
    border-width: 1px;
    border-radius: 5px;
    padding: 16px;
    margin-bottom: 14px;
}
.foc-trade-panel Label { white-space: normal; margin-bottom: 6px; }
.foc-trade-selectors { flex-direction: row; flex-wrap: wrap; }
.foc-trade-selectors > .unity-base-field { flex-grow: 1; min-width: 190px; margin-right: 10px; }
.foc-trade-data { padding-top: 14px; padding-bottom: 8px; }
.foc-trade-buttons { flex-direction: row; flex-wrap: wrap; margin-top: 8px; margin-bottom: 8px; }
.foc-trade-buttons Button { min-width: 140px; min-height: 34px; margin-right: 10px; }
#trade-price { color: rgb(239, 204, 133); font-size: 18px; }
#trade-reasons { color: rgb(211, 196, 163); }
#trade-confirmation { color: rgb(243, 218, 156); }
#trade-feedback { color: rgb(171, 218, 185); }
.foc-trade-panel .unity-base-field__label { min-width: 68px; width: 68px; }
.foc-trade-panel .unity-base-field__input {
    background-color: rgb(20, 27, 24);
    color: rgb(243, 231, 202);
    border-color: rgb(100, 112, 94);
    border-width: 1px;
    min-height: 28px;
}
.foc-trade-panel .unity-base-popup-field__text { color: rgb(243, 231, 202); }
.foc-trade-buttons Button { background-color: rgb(57, 68, 53); color: rgb(250, 228, 179); border-color: rgb(171, 143, 84); border-width: 1px; }
.foc-trade-buttons Button:disabled { background-color: rgb(42, 45, 40); color: rgb(144, 148, 136); border-color: rgb(72, 77, 68); }
.foc-trade-buttons Button:focus { border-color: rgb(247, 205, 110); border-width: 2px; }
.foc-trade-buttons Button:hover:enabled { background-color: rgb(76, 88, 65); }

.foc-city-areas { flex-direction: row; flex-wrap: wrap; }
.foc-city-area { width: 32%; height: 54px; margin-right: 1%; margin-bottom: 5px; white-space: normal; background-color: rgb(39, 49, 44); color: rgb(227, 217, 191); border-color: rgb(85, 95, 79); border-width: 1px; }
#city-inspection-panel .foc-city-selected { background-color: rgb(95, 76, 39); border-color: rgb(228, 188, 108); color: rgb(255, 238, 196); }
.foc-city-heading { margin-top: 8px; color: rgb(237, 204, 139); -unity-font-style: bold; }
#city-inspection-panel .foc-city-row { white-space: nowrap; text-overflow: ellipsis; overflow: hidden; padding: 6px; margin-bottom: 0; border-bottom-width: 1px; border-bottom-color: rgb(52, 64, 55); }
#city-stock-shortages > .unity-base-field__label { width: auto; min-width: 270px; }
#city-summary, #city-inspection-note { font-size: 12px; color: rgb(197, 199, 175); }
#city-inspection-note { margin-top: 8px; }
#city-open-market { padding-left: 12px; padding-right: 12px; background-color: rgb(57,68,53); color: rgb(250,228,179); }

.foc-report-row { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; padding-left: 10px; background-color: rgb(39,49,44); color: rgb(236,224,191); border-color: rgb(85,95,79); border-width: 1px; }
.foc-report-selected { background-color: rgb(95,76,39); border-color: rgb(228,188,108); }
.foc-report-row:hover { background-color: rgb(76,88,65); }
.foc-report-row:focus { border-color: rgb(247,205,110); border-width: 2px; }
.foc-report-observation { white-space: normal; overflow: hidden; padding: 6px; margin-bottom: 0; border-bottom-color: rgb(52,64,55); border-bottom-width: 1px; }
#report-inbox-summary, #report-inbox-empty { font-size: 12px; color: rgb(197,199,175); }
#report-detail-metadata { font-size: 12px; color: rgb(213,207,183); }

.foc-envoy-row { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; padding-left: 10px; background-color: rgb(39,49,44); color: rgb(236,224,191); border-color: rgb(85,95,79); border-width: 1px; }
.foc-envoy-selected { background-color: rgb(95,76,39); border-color: rgb(228,188,108); }
.foc-envoy-row:hover { background-color: rgb(76,88,65); }
.foc-envoy-row:focus { border-color: rgb(247,205,110); border-width: 2px; }
.foc-envoy-observation { white-space: normal; overflow: hidden; padding: 6px; margin-bottom: 0; border-bottom-color: rgb(52,64,55); border-bottom-width: 1px; }
#envoy-inbox-summary, #envoy-inbox-empty { font-size: 12px; color: rgb(197,199,175); }
#envoy-detail-metadata { font-size: 12px; color: rgb(213,207,183); }

.foc-diplomatic-row { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; padding-left: 10px; background-color: rgb(39,49,44); color: rgb(236,224,191); border-color: rgb(85,95,79); border-width: 1px; }
.foc-diplomatic-selected { background-color: rgb(95,76,39); border-color: rgb(228,188,108); }
.foc-diplomatic-row:hover { background-color: rgb(76,88,65); }
.foc-diplomatic-row:focus { border-color: rgb(247,205,110); border-width: 2px; }
.foc-diplomatic-entry { white-space: normal; overflow: hidden; padding: 6px; margin-bottom: 0; border-bottom-color: rgb(52,64,55); border-bottom-width: 1px; }
#diplomatic-summary, #diplomatic-empty { font-size: 12px; color: rgb(197,199,175); }
#diplomatic-detail-metadata { font-size: 12px; color: rgb(213,207,183); }

.foc-character-row { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; padding-left: 10px; background-color: rgb(39,49,44); color: rgb(236,224,191); border-color: rgb(85,95,79); border-width: 1px; }
.foc-character-selected { background-color: rgb(95,76,39); border-color: rgb(228,188,108); }
.foc-character-row:hover { background-color: rgb(76,88,65); }
.foc-character-row:focus { border-color: rgb(247,205,110); border-width: 2px; }
#character-directory-title { color: rgb(237,204,139); -unity-font-style: bold; }
#character-directory-count, #character-directory-empty { font-size: 12px; color: rgb(197,199,175); }
.foc-character-summary { white-space: normal; color: rgb(213,207,183); margin-top: 8px; }
#character-search > .unity-base-field__label { min-width: 92px; width: 92px; }
