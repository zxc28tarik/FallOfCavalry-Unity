* text=auto
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.ps1 text eol=crlf

# Unity writes empty YAML scalar values with a trailing space by design.
*.anim -whitespace
*.asset -whitespace
*.controller -whitespace
*.mat -whitespace
*.meta -whitespace
*.prefab -whitespace
*.unity -whitespace
